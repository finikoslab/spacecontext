// Remote MCP server for Space Context. Deploying it is a separate step from the
// API (see README): create the KV namespace, set the ids below, then
// `npm run deploy -w @spacecontext/mcp`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "spacecontext-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  // global_fetch_strictly_public: the server fetches client metadata documents
  // (CIMD) from URLs chosen by clients, so plain fetch must never reach private
  // addresses. The API is reached through the BACKEND service binding.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [{ "pattern": "mcp.spacecontext.finikos.it", "custom_domain": true }],
  "vars": {
    "API_BASE_URL": "https://api.spacecontext.finikos.it/v1",
    "PUBLIC_URL": "https://mcp.spacecontext.finikos.it"
  },
  // OAuth clients, grants and tokens (encrypted by the library).
  // Create with: wrangler kv namespace create OAUTH_KV
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_OAUTH_KV_ID" }],
  // The API reached inside Cloudflare: each user keeps their own IP for rate
  // limits and sign-in protection. Without it the Worker calls API_BASE_URL.
  "services": [{ "binding": "BACKEND", "service": "spacecontext-backend" }],
  "observability": { "enabled": true },
  "env": {
    "dev": {
      "name": "spacecontext-mcp-dev",
      // Local only: the API runs on 127.0.0.1 without a service binding, which
      // the strictly-public fetch would refuse (CIMD is then off locally).
      "compatibility_flags": ["nodejs_compat"],
      "workers_dev": false,
      "routes": [],
      "vars": {
        "API_BASE_URL": "http://127.0.0.1:8787/v1",
        "PUBLIC_URL": "http://localhost:8788"
      },
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "spacecontext-mcp-dev-oauth" }],
      "services": []
    },
    // Staging: the public API's staging Worker, on workers.dev only.
    "staging": {
      "name": "spacecontext-mcp-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "API_BASE_URL": "https://spacecontext-backend-staging.finikos.workers.dev/v1",
        "PUBLIC_URL": "https://spacecontext-mcp-staging.finikos.workers.dev",
        "APPLE_SERVICES_ID": "it.spacecontext.ai.web"
      },
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "21f82a0549ce432fa7aadf47c5a2d415" }],
      "services": [{ "binding": "BACKEND", "service": "spacecontext-backend-staging" }]
    }
  }
}
