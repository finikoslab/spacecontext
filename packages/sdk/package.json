{
  "name": "@spacecontext/sdk",
  "version": "0.2.0",
  "description": "TypeScript client for the Space Context API: spaces, scans, search and questions about physical spaces.",
  "license": "MIT",
  "author": "Finikos S.r.l.",
  "homepage": "https://spacecontext.app/developers/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finikoslab/spacecontext.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/finikoslab/spacecontext/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "openapi-typescript ../../openapi/openapi.json --default-non-nullable false -o src/generated/schema.ts && node ../../scripts/stamp-generated.mjs src/generated/schema.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  },
  "keywords": [
    "spacecontext",
    "sdk",
    "api-client",
    "ai-agents",
    "mcp",
    "physical-world",
    "context",
    "space-document",
    "video-to-json",
    "inventory",
    "property"
  ]
}
