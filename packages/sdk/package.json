{
  "name": "@spacecontext/sdk",
  "version": "0.2.0",
  "description": "TypeScript client for the Space Context API: spaces, scans, search and questions about physical spaces.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "openapi-typescript ../../openapi/openapi.json --default-non-nullable false -o src/schema.ts && node ../../scripts/stamp-generated.mjs src/schema.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  },
  "keywords": [
    "spacecontext",
    "physical-world",
    "context",
    "agents",
    "mcp",
    "inventory",
    "property"
  ]
}
